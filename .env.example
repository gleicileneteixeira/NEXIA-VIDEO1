# Copie para .env.local e preencha com os valores reais.
# Na Vercel, cadastre estas mesmas variáveis em Project > Settings > Environment Variables
# (marque Production, Preview e Development) e refaça o deploy.

# Supabase (obrigatório para login e dados)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Provedores de IA
NEXT_PUBLIC_AI_API_KEY=
NEXT_PUBLIC_GROQ_API_KEY=
GROQ_API_KEY=

# Busca de imagens
NEXT_PUBLIC_PEXELS_API_KEY=

# Armazenamento S3 / R2 (upload de mídia)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
